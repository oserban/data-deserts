# Production runtime mode.
NODE_ENV=production

# Nitro listens only on loopback because Nginx is the public entry point.
HOST=127.0.0.1
PORT=8080

# Public URL prefix exposed by Nginx. Use an empty value when hosting at the domain root.
APP_BASE_PATH=/data-deserts

# Static presenter-controller token. Use a long random value and share the complete
# /control?token=... URL only with the trusted application or presenter device.
DO_WALL_CONTROL_TOKEN=replace-with-a-long-random-token

# Lifetime of each rotating, single-use QR invitation, in seconds.
MINI_CONTROLLER_QR_TTL_SECONDS=30

# Lifetime of an opened mini-controller page, in seconds.
MINI_CONTROLLER_SESSION_TTL_SECONDS=600
