# Create a Vercel access token at https://vercel.com/account/settings/tokens
VERCEL_TOKEN=replace_with_your_vercel_token

# Find these values in .vercel/project.json after running `npx vercel link`,
# or in the Vercel project and team settings.
VERCEL_ORG_ID=replace_with_your_vercel_team_or_user_id
VERCEL_PROJECT_ID=replace_with_your_vercel_project_id
